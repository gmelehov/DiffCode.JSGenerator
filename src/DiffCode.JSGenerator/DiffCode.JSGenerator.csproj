<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiffCode.CommonExtensions" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="DiffCode.CommonExtensions" />
    <Using Include="DiffCode.JSGenerator.Extensions" />
    <Using Include="DiffCode.CommonExtensions.Interfaces" />
    <Using Include="System.Text" />
    <Using Include="System.Xml.Linq" />
    <Using Include="DiffCode.JSGenerator.Enums.TokenType" Alias="TT"/>
    <Using Include="DiffCode.JSGenerator.AbstractExpression" Alias="AE"/>
    <Using Include="DiffCode.JSGenerator.AbstractToken" Alias="AT"/>
    <Using Include="DiffCode.JSGenerator.KeyValue" Alias="KVal"/>
    <Using Include="DiffCode.JSGenerator.Common.TokenBinding" Alias="TB"/>
    <Using Include="DiffCode.JSGenerator.SimpleToken" Alias="ST"/>
    <Using Include="DiffCode.JSGenerator.AbstractOperator" Alias="AOp"/>
    <Using Include="DiffCode.JSGenerator.Helper" Static="true"/>
    <Using Include="DiffCode.JSGenerator.Generator" Static="true"/>
  </ItemGroup>
  

</Project>
